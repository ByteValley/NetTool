#!name=Spotify增强
#!desc=Experimental Surge conversion of devchristian1337 Spotify.lpx (2026-11-10). Original scripts remain hosted upstream; runtime compatibility not verified. Optional filters enabled; remote protobuf alternative disabled.
#!category=功能增强
#!author=devchristian1337 (original); Surge configuration adaptation
#!homepage=https://github.com/devchristian1337/loon-plugins

# Original: https://raw.githubusercontent.com/devchristian1337/loon-plugins/main/Plugins/Spotify.lpx
# Disable an optional filter by commenting its corresponding line in [URL Rewrite].
# This file references original upstream JavaScript. Do not assume the scripts are Surge-compatible without runtime testing.

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[Header Rewrite]
http-request ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/user-customization-service\/v1\/customize header-del If-None-Match
http-request ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$ header-del If-None-Match

[URL Rewrite]
^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/pendragon _ reject
^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:ads\/|ad-logic\/|[^?#]*\/ad-on-app-open|premium-marketing\/upsellOffer) _ reject
# Optional: hide discovery feed (default ON)
^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/watch-feed-entrypoints\/v\d\/discovery-from-seed _ reject
# Optional: hide membership information (default ON)
^https:\/\/[\w-]+-spclient\.spotify\.com(?::443)?\/pam-view-service\/ _ reject
# Optional: hide AI DJ (default ON)
37i9dQZF1EYkqdzj48dyYq _ reject

[Script]
Spotify gabo = type=http-request,pattern=^https:\/\/(?:[\w-]+-spclient\.spotify\.com(?::443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/main/Scripts/Spotify/spot-gabo.js,timeout=10
Spotify search ads = type=http-response,pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/browsita\/v.\/browse,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/main/Scripts/Spotify/spot-NoSearchAd.js,requires-body=true,binary-body-mode=true,timeout=10
Spotify home ads = type=http-response,pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/casita\/v.\/home\/,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/main/Scripts/Spotify/spot-NoHomeAd.js,requires-body=true,binary-body-mode=true,timeout=10
Spotify scroll ads = type=http-response,pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/scrollsita\/v.\/scroll\/spotify,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/main/Scripts/Spotify/spot-NoScrollAd.js,requires-body=true,binary-body-mode=true,timeout=10
# Remote protobuf mode: alternative to local bootstrap handler; DO NOT enable both.
# To use remote mode, uncomment the following line and comment the "Spotify protobuf local" line.
# Spotify protobuf remote = type=http-response,pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/main/Scripts/Spotify/spot-proto-eevee.js,requires-body=true,binary-body-mode=true,timeout=10
Spotify protobuf local = type=http-response,pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/main/Scripts/Spotify/spot-proto-ev3.js,requires-body=true,binary-body-mode=true,timeout=10
Spotify protobuf app 9.1.98+ = type=http-response,pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/main/Scripts/Spotify/spot-proto-ev3.js,requires-body=true,binary-body-mode=true,timeout=10

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com
