#!name=Spotify歌词增强
#!desc=全网多源检索歌词（QQ音乐 / 网易云 / 酷狗 / 酷我 / LRCLIB / Musixmatch），按歌名·歌手·时长·时间轴综合打分择优；外部歌词优先，找不到时保留 Spotify 原词；补中文翻译与简繁互译（小号字显示在原句下方）；播放页与歌词页同步显示；核心日志可在脚本日志与持久化数据 SpotifyLyricsEnhanced.log 中查看。
#!category=功能增强
#!arguments=原词优先:false,翻译:true,简繁互译:true,译文样式:小字,发音:true,检索预算:6500,预取预算:4000,缓存分钟:30,歌词源:qq+netease+kugou+kuwo+lrclib+musixmatch,日志级别:core
#!arguments-desc=原词优先：false = 外部源（QQ/网易云等）有可靠匹配就替换，找不到才用 Spotify 原词（默认，同旧版）；true = Spotify 有歌词时保留原词，只补译文/简繁\n翻译：外语歌词逐行附中文翻译\n简繁互译：中文歌词自动判断简/繁体，逐行附另一种写法（本地转换，不联网）\n译文样式：小字 = 走 Spotify 原生翻译，在原句下方以小号字显示（若不显示，在歌词页点「翻译」按钮；仍不显示请改用「换行」）；换行 = 直接拼在原句下一行，与原词同字号\n发音：true = 识别为闽南语/粤语时附罗马音；all = 所有中文歌词都检索；false = 关闭（来源有才显示）\n检索预算：歌词页等待外部检索的最长毫秒数（2000-12000）\n预取预算：进入播放页（metadata）时预取歌词的毫秒数，0 = 关闭预取\n缓存分钟：预取结果保留时长，0 = 关闭（关闭后预取无效）\n歌词源：用 + 连接，可删减或调整\n日志级别：core = 核心日志；debug = 输出每个请求与候选打分

[Script]
# metadata 请求：追加 nonce，避免命中 Spotify 的 has_lyrics=false 缓存
spotify-lyrics-metadata-request = type=http-request, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/metadata\/\d+\/track\/(?:[a-fA-F0-9]{32}|[A-Za-z0-9]{22})(?:[\/?]|$), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20261122-v2.7.3, timeout=10, argument="prefer_original={{{原词优先}}}&translation={{{翻译}}}&convert={{{简繁互译}}}&trans_style={{{译文样式}}}&romanization={{{发音}}}&budget={{{检索预算}}}&prefetch_budget={{{预取预算}}}&cache_minutes={{{缓存分钟}}}&sources={{{歌词源}}}&log_level={{{日志级别}}}"

# metadata 响应（JSON / Protobuf）：取歌曲资料 → 预取歌词 → 打开 has_lyrics
spotify-lyrics-metadata-json = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/metadata\/\d+\/track\/(?:[a-fA-F0-9]{32}|[A-Za-z0-9]{22})(?=[^#]*[?&]format=json(?:&|$)), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20261122-v2.7.3, requires-body=true, binary-body-mode=false, max-size=2097152, timeout=12, argument="prefer_original={{{原词优先}}}&translation={{{翻译}}}&convert={{{简繁互译}}}&trans_style={{{译文样式}}}&romanization={{{发音}}}&budget={{{检索预算}}}&prefetch_budget={{{预取预算}}}&cache_minutes={{{缓存分钟}}}&sources={{{歌词源}}}&log_level={{{日志级别}}}"

spotify-lyrics-metadata-protobuf = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/metadata\/\d+\/track\/(?:[a-fA-F0-9]{32}|[A-Za-z0-9]{22})(?![^#]*[?&]format=json(?:&|$)), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20261122-v2.7.3, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=12, argument="prefer_original={{{原词优先}}}&translation={{{翻译}}}&convert={{{简繁互译}}}&trans_style={{{译文样式}}}&romanization={{{发音}}}&budget={{{检索预算}}}&prefetch_budget={{{预取预算}}}&cache_minutes={{{缓存分钟}}}&sources={{{歌词源}}}&log_level={{{日志级别}}}"

# color-lyrics（JSON / Protobuf）：原词 + 译文 或 替换为全网最佳歌词；OPTIONS 预检原样放行
spotify-lyrics-json = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/(?:[a-fA-F0-9]{32}|[A-Za-z0-9]{22})(?=[^#]*[?&]format=json(?:&|$)), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20261122-v2.7.3, requires-body=true, binary-body-mode=false, max-size=2097152, timeout=15, argument="prefer_original={{{原词优先}}}&translation={{{翻译}}}&convert={{{简繁互译}}}&trans_style={{{译文样式}}}&romanization={{{发音}}}&budget={{{检索预算}}}&prefetch_budget={{{预取预算}}}&cache_minutes={{{缓存分钟}}}&sources={{{歌词源}}}&log_level={{{日志级别}}}"

spotify-lyrics-protobuf = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/(?:[a-fA-F0-9]{32}|[A-Za-z0-9]{22})(?![^#]*[?&]format=json(?:&|$)), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20261122-v2.7.3, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=15, argument="prefer_original={{{原词优先}}}&translation={{{翻译}}}&convert={{{简繁互译}}}&trans_style={{{译文样式}}}&romanization={{{发音}}}&budget={{{检索预算}}}&prefetch_budget={{{预取预算}}}&cache_minutes={{{缓存分钟}}}&sources={{{歌词源}}}&log_level={{{日志级别}}}"

# iOS / iPad / Android：曲目资料走批量 extended-metadata（POST），在这里打开 has_lyrics，客户端才会显示歌词入口并请求 color-lyrics
spotify-lyrics-extended-metadata = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/extended-metadata\/v\d+\/extended-metadata, script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20261122-v2.7.3, requires-body=true, binary-body-mode=true, max-size=4194304, timeout=12, argument="prefer_original={{{原词优先}}}&translation={{{翻译}}}&convert={{{简繁互译}}}&trans_style={{{译文样式}}}&romanization={{{发音}}}&budget={{{检索预算}}}&prefetch_budget={{{预取预算}}}&cache_minutes={{{缓存分钟}}}&sources={{{歌词源}}}&log_level={{{日志级别}}}"

# 诊断（仅 日志级别=debug 时记录，不修改响应）：iOS 播放页卡片列表 scrollsita
spotify-lyrics-scroll = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/scrollsita\/v\d+\/scroll\/, script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20261122-v2.7.3, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=5, argument="prefer_original={{{原词优先}}}&translation={{{翻译}}}&convert={{{简繁互译}}}&trans_style={{{译文样式}}}&romanization={{{发音}}}&budget={{{检索预算}}}&prefetch_budget={{{预取预算}}}&cache_minutes={{{缓存分钟}}}&sources={{{歌词源}}}&log_level={{{日志级别}}}"



[Rule]
# 阻止 spclient 走 QUIC(HTTP/3)：QUIC 无法被 MITM，手机端会绕过脚本
AND,((PROTOCOL,QUIC),(DOMAIN-KEYWORD,spclient)),REJECT-NO-DROP

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, spclient.spotify.com, *spclient.spotify.com
