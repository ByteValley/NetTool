#!name=Spotify歌词增强
#!desc=补充 Spotify 歌词。
#!category=功能增强

[Script]

# context-resolve JSON：记录并兼容其中可能携带的歌词可用标记
spotify-lyrics-context-response = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/context-resolve\/v1\/spotify:track:[A-Za-z0-9]{22}(?:[\/?]|$), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20260922-playback-fix1, requires-body=true, binary-body-mode=false, max-size=2097152, timeout=10

# iPhone 的歌词元数据主要走这里，而不是旧的 /metadata 路径
spotify-lyrics-extended-metadata = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/extended-metadata\/v0\/extended-metadata(?:[\/?]|$), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20260922-playback-fix1, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=10

# metadata JSON
spotify-lyrics-metadata-json = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/metadata\/\d+\/track\/(?:[a-fA-F0-9]{32}|[A-Za-z0-9]{22})(?=[^#]*[?&]format=json(?:&|$)), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20260922-playback-fix1, requires-body=true, binary-body-mode=false, max-size=2097152, timeout=10

# metadata Protobuf
spotify-lyrics-metadata-protobuf = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/metadata\/\d+\/track\/(?:[a-fA-F0-9]{32}|[A-Za-z0-9]{22})(?![^#]*[?&]format=json(?:&|$)), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20260922-playback-fix1, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=10

# color-lyrics JSON
spotify-lyrics-json = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/(?:[a-fA-F0-9]{32}|[A-Za-z0-9]{22})(?=[^#]*[?&]format=json(?:&|$)), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20260922-playback-fix1, requires-body=true, binary-body-mode=false, max-size=2097152, timeout=10

# color-lyrics Protobuf；OPTIONS 预检也会进入同一脚本并原样放行
spotify-lyrics-protobuf = type=http-response, pattern=^https:\/\/(?:spclient(?:\.wg)?|[\w-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/(?:[a-fA-F0-9]{32}|[A-Za-z0-9]{22})(?![^#]*[?&]format=json(?:&|$)), script-path=https://raw.githubusercontent.com/ByteValley/NetTool/main/Beta/Scripts/Enhancement/Spotify.Lyrics.Independent.Surge.js?v=20260922-playback-fix1, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=10

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, spclient.spotify.com, *spclient.spotify.com
